#!/bin/bash
# Root-owned helper: consumes a dashboard-originated, confirmed restart-only
# request. This is the ONLY script permitted to restart valheim.service on
# demand outside the 00:00/12:00 Asia/Shanghai maintenance timer, and it is
# rate-limited by a fixed cooldown. It never touches the modpack manifest,
# lock, or releases. Triggered by valheim-dashboard-actions.path.
#
# Installing the corresponding .path/.service unit does not, by itself,
# authorize a restart: the unit must additionally be started/enabled, and a
# dashboard operator must submit an explicit, typed confirmation before this
# script ever runs.
set -Eeuo pipefail

readonly PENDING_DIRECTORY=/var/lib/valheim-dashboard/pending
readonly STATE_DIRECTORY=/var/lib/valheim-dashboard/state
readonly PENDING_REQUEST="$PENDING_DIRECTORY/restart-request.json"
readonly RESULT_FILE="$STATE_DIRECTORY/restart-result.json"
readonly COOLDOWN_FILE="$STATE_DIRECTORY/restart-cooldown.json"
readonly COOLDOWN_SECONDS=900
readonly VALHEIM_LOG=/opt/valheim/logs/valheim.log
readonly BEPINEX_LOG=/opt/valheim/modpack/current/BepInEx/LogOutput.log
readonly READY_MARKER='Game server connected'
readonly HEALTH_TIMEOUT_SECONDS=180

log() {
    printf 'valheim-restart-request event=%s %s\n' "$1" "${2:-}"
}

write_result() {
    local outcome=$1 message=${2:-}
    install -d -o root -g valheim-ui -m 0750 "$STATE_DIRECTORY"
    local temporary
    temporary=$(mktemp "$STATE_DIRECTORY/.restart-result.XXXXXX")
    printf '{"outcome":"%s","message":"%s"}\n' "$outcome" "$message" >"$temporary"
    chmod 0640 "$temporary"
    chown root:valheim-ui "$temporary"
    mv -Tf -- "$temporary" "$RESULT_FILE"
}

seconds_since_last_restart() {
    [[ -f "$COOLDOWN_FILE" ]] || { echo 999999; return 0; }
    /usr/bin/python3 - "$COOLDOWN_FILE" <<'PY'
import json
import sys
import time

try:
    with open(sys.argv[1], "rb") as source:
        value = json.load(source)["last_triggered_epoch"]
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(value, int) or isinstance(value, bool) or value < 0:
    raise SystemExit(1)
print(max(0, time.time_ns() // 1_000_000_000 - value))
PY
}

record_cooldown() {
    install -d -o root -g valheim-ui -m 0750 "$STATE_DIRECTORY"
    local temporary
    temporary=$(mktemp "$STATE_DIRECTORY/.restart-cooldown.XXXXXX")
    printf '{"last_triggered_epoch":%s}\n' "$(date +%s)" >"$temporary"
    chmod 0640 "$temporary"
    chown root:valheim-ui "$temporary"
    mv -Tf -- "$temporary" "$COOLDOWN_FILE"
}

log_snapshot() {
    /usr/bin/stat -c '%d:%i:%s' "$1" 2>/dev/null || printf 'missing:0'
}

log_has_new_ready_marker() {
    local log_path=$1 initial_snapshot=$2 initial_identity initial_size current_snapshot
    local current_identity current_size start_byte
    initial_identity=${initial_snapshot%:*}
    initial_size=${initial_snapshot##*:}
    current_snapshot=$(log_snapshot "$log_path")
    [[ "$current_snapshot" != 'missing:0' ]] || return 1
    current_identity=${current_snapshot%:*}
    current_size=${current_snapshot##*:}
    start_byte=$((initial_size + 1))
    if [[ "$current_identity" != "$initial_identity" ]] || (( current_size < initial_size )); then
        start_byte=1
    fi
    /usr/bin/grep -Fq "$READY_MARKER" < <(/usr/bin/tail -c "+$start_byte" "$log_path")
}

wait_for_server_health() {
    local initial_valheim_log initial_bepinex_log deadline
    initial_valheim_log=$(log_snapshot "$VALHEIM_LOG")
    initial_bepinex_log=$(log_snapshot "$BEPINEX_LOG")
    deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))
    while (( SECONDS < deadline )); do
        if ! /usr/bin/systemctl is-active --quiet valheim.service; then
            return 1
        fi
        if log_has_new_ready_marker "$VALHEIM_LOG" "$initial_valheim_log" ||
            log_has_new_ready_marker "$BEPINEX_LOG" "$initial_bepinex_log"; then
            return 0
        fi
        /usr/bin/sleep 2
    done
    return 1
}

request_is_valid() {
    /usr/bin/python3 -c '
import json, sys
try:
    with open(sys.argv[1], "rb") as handle:
        request = json.load(handle)
    ok = (
        isinstance(request, dict)
        and set(request) == {"schema_version", "requested_at", "reason"}
        and request["schema_version"] == 1
        and isinstance(request["requested_at"], str)
        and len(request["requested_at"]) <= 40
        and isinstance(request["reason"], str)
        and len(request["reason"]) <= 200
    )
except (OSError, TypeError, UnicodeDecodeError, json.JSONDecodeError):
    ok = False
sys.exit(0 if ok else 1)
' "$1"
}

if [[ ! -f "$PENDING_REQUEST" ]]; then
    log skipped 'reason=no_pending_request'
    exit 0
fi

if ! request_is_valid "$PENDING_REQUEST"; then
    log rejected 'reason=invalid_request_schema'
    write_result rejected 'The restart request failed independent schema validation.'
    rm -f -- "$PENDING_REQUEST"
    exit 0
fi

if ! elapsed=$(seconds_since_last_restart); then
    log rejected 'reason=cooldown_state_invalid'
    write_result rejected 'Restart cooldown state is invalid; no restart was triggered.'
    rm -f -- "$PENDING_REQUEST"
    exit 0
fi
if (( elapsed < COOLDOWN_SECONDS )); then
    log rejected "reason=cooldown_active elapsed=${elapsed}s"
    write_result rejected "A restart was already triggered ${elapsed}s ago; try again later."
    rm -f -- "$PENDING_REQUEST"
    exit 0
fi

log restart_started
record_cooldown
/usr/bin/systemctl restart valheim.service
if wait_for_server_health; then
    log restart_succeeded
    write_result success 'Valheim restarted and reached the ready marker.'
else
    log restart_health_check_failed
    write_result failed 'Valheim restarted but did not reach the ready marker in time.'
fi
rm -f -- "$PENDING_REQUEST"
