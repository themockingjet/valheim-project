#!/bin/bash
# Run by valheim-restart.timer before scheduled maintenance. The plugin accepts
# only callers with the same Unix UID as the Valheim server.
set -Eeuo pipefail

readonly SOCKET_PATH=/run/valheim/lifecycle-announcer.sock

log() {
    printf 'valheim-restart-announcement event=%s %s\n' "$1" "${2:-}"
}

send() {
    local request_id=$1 message=$2 response
    response=$(/usr/bin/python3 - "$SOCKET_PATH" "$request_id" "$message" <<'PYTHON'
import json
import socket
import sys

socket_path, request_id, message = sys.argv[1:]
payload = json.dumps({
    "schema_version": 1,
    "operation": "broadcast",
    "id": request_id,
    "message": message,
}, separators=(",", ":")).encode("utf-8")

client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.settimeout(5)
try:
    client.connect(socket_path)
    client.sendall(payload)
    client.shutdown(socket.SHUT_WR)
    response = bytearray()
    while True:
        chunk = client.recv(4096)
        if not chunk:
            break
        response.extend(chunk)
finally:
    client.close()

print(response.decode("utf-8"))
PYTHON
)
    if ! /usr/bin/printf '%s' "$response" | /usr/bin/python3 -c \
        'import json, sys; value = json.load(sys.stdin); raise SystemExit(0 if value.get("ok") is True else 1)'; then
        log failed 'reason=plugin_rejected_request'
        return 1
    fi
}

send_burst() {
    local warning_id=$1 message=$2 attempt
    for attempt in 1 2 3; do
        send "${warning_id}-${attempt}" "$message"
        if (( attempt < 3 )); then
            /usr/bin/sleep 3
        fi
    done
}

if [[ ! -S "$SOCKET_PATH" ]]; then
    log skipped 'reason=plugin_socket_unavailable'
    exit 0
fi

send_burst 'scheduled-restart-15m' 'Scheduled server restart begins in 15 minutes. Please move somewhere safe.'
/usr/bin/sleep 294
send_burst 'scheduled-restart-10m' 'Scheduled server restart begins in 10 minutes. Please move somewhere safe.'
/usr/bin/sleep 294
send_burst 'scheduled-restart-5m' 'Scheduled server restart begins in 5 minutes. Please move somewhere safe.'
/usr/bin/sleep 114
send_burst 'scheduled-restart-3m' 'Scheduled server restart begins in 3 minutes. Please log out safely.'
/usr/bin/sleep 114
send_burst 'scheduled-restart-1m' 'Scheduled server restart begins in 1 minute. Please log out safely.'
/usr/bin/sleep 54
send 'scheduled-restart-now' 'Scheduled server restart is starting now.'
log completed
