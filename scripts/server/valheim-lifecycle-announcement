#!/bin/bash
# Run by valheim.service before normal systemd stops and restarts. The plugin
# accepts only callers with the same Unix UID as the Valheim server.
set -Eeuo pipefail

readonly SOCKET_PATH=/run/valheim/lifecycle-announcer.sock

log() {
    printf 'valheim-lifecycle-announcement event=%s %s\n' "$1" "${2:-}"
}

send() {
    local payload=$1 response
    response=$(/usr/bin/printf '%s' "$payload" | /usr/bin/nc -N -U "$SOCKET_PATH")
    if ! /usr/bin/printf '%s' "$response" | /usr/bin/python3 -c \
        'import json, sys; value = json.load(sys.stdin); raise SystemExit(0 if value.get("ok") is True else 1)'; then
        log failed 'reason=plugin_rejected_request'
        return 1
    fi
}

if [[ ! -S "$SOCKET_PATH" ]]; then
    log skipped 'reason=plugin_socket_unavailable'
    exit 0
fi

send '{"schema_version":1,"operation":"broadcast","id":"shutdown-5m","message":"Server restart begins in 5 minutes. Please move somewhere safe."}'
/usr/bin/sleep 240
send '{"schema_version":1,"operation":"broadcast","id":"shutdown-1m","message":"Server restart begins in 1 minute. Please log out safely."}'
/usr/bin/sleep 50
send '{"schema_version":1,"operation":"broadcast","id":"shutdown-10s","message":"Server restart begins in 10 seconds."}'
/usr/bin/sleep 10
send '{"schema_version":1,"operation":"broadcast","id":"shutdown-now","message":"Server is restarting now."}'
log completed
