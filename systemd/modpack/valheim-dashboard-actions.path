[Unit]
Description=Detect pending dashboard action requests

[Path]
PathExists=/var/lib/valheim-dashboard/pending/manifest-request.json
PathExists=/var/lib/valheim-dashboard/pending/config-request.json
PathExists=/var/lib/valheim-dashboard/pending/update-request.json
PathExists=/var/lib/valheim-dashboard/pending/rollback-request.json
PathExists=/var/lib/valheim-dashboard/pending/world-restore-request.json
Unit=valheim-dashboard-actions.service

[Install]
WantedBy=multi-user.target
