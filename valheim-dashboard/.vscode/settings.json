{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "backend/tests",
    "-p",
    "test_*.py"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "backend/.venv": true,
    "frontend/node_modules": true,
    "frontend/dist": true
  }
}
